            "url": {
              "raw": "{{base_url}}/api/v1/tickets/{{ticket_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "tickets", "{{ticket_id}}"]
            }
          }
        },
        {
          "name": "Update Ticket Title/Desc (Customer)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customer_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
