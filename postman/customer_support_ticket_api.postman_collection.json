    {
      "name": "Tickets",
      "item": [
        {
          "name": "Create Ticket (Customer)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.id) {",
                  "    pm.collectionVariables.set('ticket_id', jsonData.id);",
                  "    console.log('Saved ticket_id: ' + jsonData.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customer_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Unable to export analytics CSV report\",\n  \"description\": \"Clicking the export button causes a 500 internal server error.\",\n  \"priority\": \"high\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/tickets",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "tickets"]
            }
          }
        },
