            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Unable to export analytics CSV report (Chrome on Windows)\",\n  \"description\": \"Updated details: error reproduces only on Chrome 124.\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/tickets/{{ticket_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "tickets", "{{ticket_id}}"]
