    {
      "name": "Analytics (Admin Only)",
      "item": [
        {
          "name": "Ticket Status Counts",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/analytics/tickets/status-counts",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "analytics", "tickets", "status-counts"]
            },
            "description": "Returns aggregate count of tickets across all supported statuses, guaranteed to include zero-ticket statuses."
          }
        },
        {
          "name": "Agents Ranked by Unresolved Tickets",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/analytics/agents/unresolved",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "analytics", "agents", "unresolved"]
