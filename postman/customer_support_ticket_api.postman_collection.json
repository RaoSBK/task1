          }
        },
        {
          "name": "List All Tickets with Filters & Pagination (Admin)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/tickets?status=in_progress&priority=high&page=1&page_size=20",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "tickets"],
              "query": [
                {
                  "key": "status",
                  "value": "in_progress"
