# ==============================================================================
# Environment Configuration (.env.example)
# Customer Support Ticket Management System
# ==============================================================================

# Application Environment
ENVIRONMENT=development
PROJECT_NAME="Customer Support Ticket Management System"
API_V1_STR=/api/v1

# PostgreSQL Database Configuration
# Note: SQLite or in-memory fallback is disabled. Valid PostgreSQL parameters are required.
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=support_ticket_db

# Optional Direct Database URL (takes precedence over separate POSTGRES_* settings if provided)
# DATABASE_URL=postgresql+psycopg2://postgres:your_secure_password_here@localhost:5432/support_ticket_db

# Test Database Configuration
POSTGRES_TEST_DB=support_ticket_test
# TEST_DATABASE_URL=postgresql+psycopg2://postgres:your_secure_password_here@localhost:5432/support_ticket_test

# Core Security / Authentication Settings
# IMPORTANT: Generate a secure, random secret key (minimum 32 characters) using:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# The application will fail startup if SECRET_KEY is missing, < 32 characters, or left as this placeholder.
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
